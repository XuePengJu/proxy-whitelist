{
  "manifest_version": 3,
  "name": "ClashMate",
  "version": "1.0.0",
  "description": "白名单走代理：仅白名单内域名走 Clash 代理，其余直连。支持抓取页面接口域名，一键加入白名单",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ClashMate",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}